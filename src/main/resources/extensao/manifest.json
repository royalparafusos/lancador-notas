{
  "manifest_version": 3,
  "name": "Lançador de Notas — Conector do DED+",
  "version": "1.4.0",
  "description": "Liga o programa Lançador de Notas ao DED+ aberto no navegador, para lançar as notas da folha fotografada.",
  "icons": {
    "128": "icone.png"
  },
  "action": {
    "default_title": "Lançador de Notas — Conector",
    "default_icon": "icone.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "http://127.0.0.1:47321/*",
    "https://dedmais.educacao.mg.gov.br/*",
    "https://ssc.prodemge.gov.br/*"
  ],
  "permissions": [
    "scripting"
  ]
}
