{
  "manifest_version": 3,
  "name": "Lançador de Notas — Conector do DED+",
  "version": "1.0.0",
  "description": "Liga o programa Lançador de Notas ao DED+ aberto neste navegador. Só funciona nas páginas do DED+/Seg.ID e só conversa com o programa neste computador.",
  "icons": { "128": "icone.png" },
  "action": { "default_title": "Lançador de Notas — Conector", "default_icon": "icone.png" },
  "background": { "service_worker": "background.js" },
  "host_permissions": ["http://127.0.0.1:47321/*"],
  "content_scripts": [
    {
      "matches": ["https://dedmais.educacao.mg.gov.br/*", "https://ssc.prodemge.gov.br/*"],
      "js": ["conteudo.js"],
      "run_at": "document_idle"
    }
  ]
}
